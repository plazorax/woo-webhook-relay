{
    "name": "plazorax/woo-webhook-relay",
    "description": "Signed WooCommerce webhooks with retries, a delivery log and replay.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Oleksii Shaposhnikov",
            "homepage": "https://github.com/plazorax"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/woocommerce-stubs": "^11.2",
        "php-stubs/wp-cli-stubs": "^2.11",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "WooWebhookRelay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WooWebhookRelay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
